generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  titleEn     String?
  subtitle    String?
  content     String
  contentType String   @default("markdown") // "markdown" | "html"
  contentEn   String?
  excerpt     String?
  excerptEn   String?
  category    Category
  coverImage     String?
  thumbnailData  String?   // base64 encoded thumbnail image
  published      Boolean  @default(false)
  featured    Boolean  @default(false)
  readingTime Int      @default(0)
  tags        String[]
  locale      String   @default("ko")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Commit 관련 필드
  commitHash       String?
  commitUrl        String?
  repoName         String?
  projectSlug      String?
  filesChanged     Int?

  // 시리즈 관련
  series      Series?  @relation(fields: [seriesId], references: [id])
  seriesId    String?
  seriesOrder Int?

  // 검수
  validationScore  Int?      // 0~100
  validationIssues String?   // JSON: [{severity, code, message}]
  validatedAt      DateTime?

  // 조회수
  viewCount      Int      @default(0)
  botViewCount   Int      @default(0)
  analytics      DailyAnalytics[]

  @@index([category])
  @@index([published])
  @@index([createdAt])
  @@index([projectSlug])
  @@index([validationScore])
}

model Series {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  posts       Post[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ApiKey {
  id        String   @id @default(cuid())
  name      String
  key       String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  lastUsed  DateTime?
}

model WatchedRepo {
  id              String   @id @default(cuid())
  owner           String
  name            String
  branch          String   @default("main")
  active          Boolean  @default(true)
  autoPublish     Boolean  @default(false)
  promptTemplate  String?
  categoryMapping String?
  githubHookId    Int?
  createdAt       DateTime @default(now())

  @@unique([owner, name])
}

model DailyAnalytics {
  id     String   @id @default(cuid())
  postId String
  post   Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  views    Int      @default(0)
  botViews Int      @default(0)

  @@unique([postId, date])
  @@index([date])
  @@index([postId])
}

model Project {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  icon        String   @default("📦")
  gradient    String   @default("from-[#3182F6] to-[#1D4ED8]")
  tags        String[]
  githubUrl   String?
  deployUrl   String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model SignalItem {
  id           String   @id @default(cuid())
  externalId   String   @unique
  canonicalUrl String?
  source       String
  sourceType   String   // "community" | "research" | "industry"
  title        String
  url          String
  score        Int      @default(0)
  summary      String?
  fetchedAt    DateTime @default(now())
  usedInPost   String?

  @@index([fetchedAt])
  @@index([source])
  @@index([sourceType])
  @@index([usedInPost])
}

// 자동 발행 트리거 1회 = 1행. 발행/스킵/실패와 사유를 기록해 모니터링 페이지에서 노출.
model PublishRun {
  id         String   @id @default(cuid())
  job        String   // "daily-ai" | "claude-ai"
  status     String   // "posted" | "skipped" | "failed"
  reason     String?  // 스킵 사유 또는 에러 메시지
  postId     String?  // status="posted"일 때 생성된 글 id
  durationMs Int?     // 트리거 처리 시간(ms)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([job])
}

enum Category {
  commits
  articles
  casual
  signal
  hallucination
}

// ===== Community Board (memradar 사용자 커뮤니티) =====
// 블로그 모델과 완전 분리. 사용자 정체성은 GitHub 숫자 ID(불변)를 PK로 사용.

enum BoardCategory {
  showcase // 자랑 (이미지 중심)
  chat     // 잡담
  question // 질문
}

model BoardUser {
  id        String   @id // GitHub 계정 숫자 ID (account.providerAccountId, 불변)
  username  String // GitHub login (가변 — 쓰기 시마다 갱신)
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts     BoardPost[]
  comments  BoardComment[]
  reactions BoardReaction[]
  images    BoardImage[]
}

model BoardPost {
  id        String        @id @default(cuid())
  category  BoardCategory
  title     String
  body      String // plain text만 저장 (HTML/마크다운 렌더 금지)
  author    BoardUser     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  comments  BoardComment[]
  reactions BoardReaction[]
  images    BoardImage[]

  @@index([category, createdAt])
  @@index([createdAt])
  @@index([authorId])
}

model BoardComment {
  id        String    @id @default(cuid())
  post      BoardPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  author    BoardUser @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  createdAt DateTime  @default(now())

  @@index([postId, createdAt])
  @@index([authorId])
}

model BoardReaction {
  id        String    @id @default(cuid())
  post      BoardPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      BoardUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  emoji     String // 서버 화이트리스트 검증 (board.ts BOARD_EMOJIS)
  createdAt DateTime  @default(now())

  @@unique([postId, userId, emoji])
  @@index([postId])
}

model BoardImage {
  id         String     @id @default(cuid())
  data       Bytes // bytea 원본 (2MB 캡, 매직바이트 검증 통과분만)
  mimeType   String // image/png | image/jpeg | image/webp
  size       Int
  width      Int?
  height     Int?
  uploader   BoardUser  @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  uploaderId String
  post       BoardPost? @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     String? // null = 아직 글에 연결 안 된 고아 (24h 후 기회적 스윕 대상)
  createdAt  DateTime   @default(now())

  @@index([postId])
  @@index([uploaderId, createdAt])
}
